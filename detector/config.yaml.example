log_path: /var/lib/docker/volumes/hng-stage3_HNG-nginx-logs/_data/hng-access.log

sliding_window:
  per_ip_seconds: 60
  global_seconds: 60

baseline:
  window_minutes: 30
  recalculate_every_seconds: 60
  min_samples: 5
  floor_mean: 0.1
  floor_stddev: 0.1

detection:
  z_score_threshold: 1.5
  rate_multiplier_threshold: 1.5
  error_rate_multiplier: 2.0

blocking:
  ban_schedule_minutes: [10, 30, 120, -1]  # -1 means permanent

slack:
  webhook_url: "WEBHOOK"

dashboard:
  port: 8080
  refresh_seconds: 3

audit_log: /var/log/detector/audit.log
